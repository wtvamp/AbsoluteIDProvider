<Project Sdk="WixToolset.Sdk/6.0.0">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="icon.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- RegistrySearch, etc. -->
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.0" PrivateAssets="all" />
    <!-- .NET helper (optional since you chain the runtime) -->
    <PackageReference Include="WixToolset.NetFx.wixext" Version="6.0.0" PrivateAssets="all" />
    <!-- WixStandardBootstrapperApplication -->
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AbsoluteIDCredentialSetup\AbsoluteIDCredentialSetup\AbsoluteIDCredentialSetup.csproj" />
    <ProjectReference Include="..\AbsoluteIDInstaller\AbsoluteIDInstaller.wixproj" />
    <ProjectReference Include="..\SampleV2CredentialProvider.vcxproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Runtime\windowsdesktop-runtime-8.0.15-win-x64.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>