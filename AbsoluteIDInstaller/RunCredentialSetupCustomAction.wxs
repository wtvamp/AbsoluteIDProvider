<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <CustomAction Id="RunAbsoluteIDCredentialSetup"
                  Directory="INSTALLDIR"
                  ExeCommand="[INSTALLDIR]AbsoluteIDCredentialSetup.exe"
                  Execute="deferred"
                  Return="check"
                  Impersonate="yes" />
  </Fragment>
  <Fragment>
    <InstallExecuteSequence>
      <Custom Action="RunAbsoluteIDCredentialSetup" After="InstallFiles"></Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
