<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <CustomAction Id="SetRunCredentialCA"
                  Property="RunCredentialSetupCA"
                  Value="adduser [USERNAME]"
                  Execute="immediate" />
    <CustomAction Id="RunAbsoluteIDCredentialSetup"
                  FileRef="AbsoluteIDCredentialSetupExeFile"
                  ExeCommand="[CustomActionData]"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />
    
    
  </Fragment>
  <Fragment>
    <InstallExecuteSequence>
      <Custom Action="SetRunCredentialCA" After="InstallFiles" Condition="NOT Installed"></Custom>
      <Custom Action="RunAbsoluteIDCredentialSetup" After="SetRunCredentialCA" Condition="NOT Installed"></Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
