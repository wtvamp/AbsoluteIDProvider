<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="CredentialSetupComponents" Directory="INSTALLFOLDER">
      <Component Id="AbsoluteIDCredentialSetupExe">
        <File Id="AbsoluteIDCredentialSetupExeFile"
              Name="AbsoluteIDCredentialSetup.exe"
              KeyPath="yes" />
        <File
          Id="AbsoluteIDCredentialSetupRuntimeConfig"
          Source="AbsoluteIDCredentialSetup.runtimeconfig.json" />
        <File
          Id="AbsoluteIDCredentialSetupDeps"
          Source="AbsoluteIDCredentialSetup.deps.json" />
      </Component>
      <Component Id="AbsoluteIDCredentialSetupDll" Guid="*">
        <File Id="AbsoluteIDCredentialSetupDllFile"
              Name="AbsoluteIDCredentialSetup.dll"
              KeyPath="yes">
        </File>
      </Component>
      <Component Id="SystemSecurityCryptographyProtectedDataDll" Guid="*">
        <File Id="SystemSecurityCryptographyProtectedDataFile"
              Name="System.Security.Cryptography.ProtectedData.dll"
              KeyPath="yes">
        </File>
      </Component>

    </ComponentGroup>
  </Fragment>
</Wix>
